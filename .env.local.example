# ============================================================
# Jiyan ژیان — Miljövariabler
# Kopiera till .env.local och fyll i dina värden:
#   cp .env.local.example .env.local
# ============================================================

# ------------------------------------------------------------
# Sanity CMS
# Hitta projekt-ID på: https://www.sanity.io/manage
# ------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# API-token med editor-rättigheter (behövs för webhooks & CORS-setup)
# Skapa på: sanity.io/manage → ditt projekt → API → Tokens
SANITY_API_TOKEN=

# Hemlighet för ISR-webhook (välj ett starkt slumpmässigt värde)
# Generera t.ex. med: openssl rand -hex 32
SANITY_WEBHOOK_SECRET=

# ------------------------------------------------------------
# Site
# ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://jiyan.vercel.app

# ------------------------------------------------------------
# Next.js Auth (om autentisering används i framtiden)
# Generera med: openssl rand -hex 32
# ------------------------------------------------------------
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://jiyan.vercel.app
